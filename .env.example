# Firebase Configuration
# Firebase Console > プロジェクトの設定 > 全般 > マイアプリ (Web アプリ) から取得
# https://console.firebase.google.com/

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Google サインイン用 OAuth クライアント ID
# Google Cloud Console > API とサービス > 認証情報 から取得
# (Firebase で Google 認証を有効化すると Web クライアント ID が自動生成される)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxx.apps.googleusercontent.com
# ネイティブビルドを作る場合のみ必要（Expo Go では Web クライアント ID を使用）
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
